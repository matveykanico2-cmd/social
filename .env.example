# Public URL used in password-reset links
APP_URL=http://localhost:3000

# Admin account phone number (normalized comparison, no email confirmation required).
SNAPGRAM_ADMIN_PHONE=+797819827502

# Yandex Mail SMTP. Use an app password, not your normal Yandex ID password.
YANDEX_EMAIL=your-login@yandex.ru
YANDEX_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional; defaults to YANDEX_EMAIL. It must be the same mailbox for Yandex SMTP.
SMTP_FROM=your-login@yandex.ru

# Optional Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:your-login@yandex.ru
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Optional database override
# SNAPGRAM_DB=data/snapgram.db

# Optional WebSocket runtime (use `npm run start:ws`)
# NEXT_PUBLIC_WS_ENABLED=1
# NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/ws

# Required before enabling encrypted TOTP enrollment
# SHALTER_TOTP_ENCRYPTION_KEY=64-hexadecimal-characters

# Optional local S3/MinIO and WebRTC/RTMP adapters
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=shalter
# S3_ACCESS_KEY=shalter-local
# S3_SECRET_KEY=shalter-local-secret
# TURN_URL=turn:localhost:3478
# TURN_USER=shalter
# TURN_PASSWORD=change-me
# RTMP_INGEST_URL=rtmp://localhost:1935/live
